AI_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=qwen3-8b
# Optional absolute paths; defaults resolve relative to the project or PATH.
PIP_LLAMA_MODEL=
PIP_LLAMA_SERVER=
PIP_STRICT_LOCAL_AI=false
AI_TIMEOUT_MS=15000
ALLOW_CLOUD_FALLBACK=false
AI_FALLBACK_PROVIDER=none
DEMO_MODE=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3:8b
LOCAL_AI_QUALITY_MODEL=qwen3:14b
LOCAL_STT_URL=http://127.0.0.1:8178
WHISPER_DEVICE=auto
# Optional faster-whisper adapter. Install its Python environment and model outside the repository.
PIP_SPEECH_ENGINE=whisper.cpp
PIP_PYTHON=
PIP_FASTER_WHISPER_MODEL=
